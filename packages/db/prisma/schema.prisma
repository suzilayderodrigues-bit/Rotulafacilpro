generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  customIngredients   Ingredient[]
  recipes             Recipe[]
  barcodes            Barcode[]
  subscriptions       Subscription[]
  billingCycles       BillingCycle[]
  barcodeUsages       BarcodeUsage[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum IngredientSource {
  BASE_ROTULA
  CUSTOM
}

enum IngredientBaseUnit {
  GRAM
  MILLILITER
}

enum RecipePhysicalState {
  SOLID_OR_SEMISOLID
  LIQUID
}

enum RecipeDisclosureStatus {
  CONTAINS
  DOES_NOT_CONTAIN
  NEEDS_REVIEW
}

enum RecipeCrossContaminationRisk {
  YES
  NO
  UNKNOWN
}

enum FrontOfPackRegulatoryCategory {
  OUTSIDE_ANNEX_XVI
  PLAIN_PLANT_FOOD
  FLOUR
  MEAT_OR_FISH
  EGG
  FERMENTED_MILK
  CHEESE
  MAMMAL_MILK
  MILK_POWDER
  OLIVE_OR_OTHER_VEGETABLE_OIL
  SALT
  INFANT_FORMULA
  ENTERAL_FORMULA
  WEIGHT_CONTROL_FOOD
  DIETARY_SUPPLEMENT
  ALCOHOLIC_BEVERAGE
  INDUSTRIAL_PROCESSING_ONLY
  FOOD_SERVICE_ONLY
  FOOD_ADDITIVE_OR_PROCESSING_AID
  DIETARY_FORMULA_FOR_INBORN_ERRORS
}

enum FrontOfPackPackagingCondition {
  PACKAGED_IN_ABSENCE_OF_CONSUMER
  NOT_PACKAGED_IN_ABSENCE_OF_CONSUMER
  PACKED_AT_POINT_OF_SALE_AT_CONSUMER_REQUEST
  PREPARED_OR_PORTIONED_AND_SOLD_ON_PREMISES
}

enum BarcodeType {
  OFFICIAL_GTIN
  INTERNAL
}

enum BarcodeValueFormat {
  GTIN_8
  GTIN_12
  GTIN_13
  GTIN_14
  INTERNAL
}

enum CommercialPlan {
  FREE
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELED
}

model Ingredient {
  id              String             @id @default(cuid())
  name            String
  normalizedName  String
  source          IngredientSource
  category        String
  dataOrigin      String
  dataOriginUrl   String?
  sourceCode      String?
  sourceVersion   String?
  baseUnit        IngredientBaseUnit @default(GRAM)
  baseQuantity    Decimal            @default(100) @db.Decimal(10, 2)
  caloriesKcal    Decimal?           @db.Decimal(10, 2)
  carbohydratesG  Decimal?           @db.Decimal(10, 2)
  proteinsG       Decimal?           @db.Decimal(10, 2)
  totalFatG       Decimal?           @db.Decimal(10, 2)
  saturatedFatG   Decimal?           @db.Decimal(10, 2)
  transFatG       Decimal?           @db.Decimal(10, 2)
  fiberG          Decimal?           @db.Decimal(10, 2)
  sodiumMg        Decimal?           @db.Decimal(10, 2)
  sugarsG         Decimal?           @db.Decimal(10, 2)
  addedSugarsG    Decimal?           @db.Decimal(10, 2)
  calciumMg       Decimal?           @db.Decimal(10, 2)
  ironMg          Decimal?           @db.Decimal(10, 2)
  allergens       String[]           @default([])
  containsGluten  Boolean?
  containsLactose Boolean?
  notes           String?
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeItems     RecipeIngredient[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([source])
  @@index([category])
  @@index([userId])
  @@index([normalizedName])
  @@index([dataOrigin, sourceCode])
  @@map("ingredients")
}

model Recipe {
  id                          String                        @id @default(cuid())
  userId                      String
  name                        String
  foodCategory                String?
  regulatoryCategory          FrontOfPackRegulatoryCategory?
  packagingCondition          FrontOfPackPackagingCondition?
  mainPanelWidthCm            Decimal?                      @db.Decimal(10, 2)
  mainPanelHeightCm           Decimal?                      @db.Decimal(10, 2)
  physicalState               RecipePhysicalState
  finalYieldAmount            Decimal?                      @db.Decimal(10, 2)
  finalYieldUnit              IngredientBaseUnit
  unitsProduced               Int?
  unitWeight                  Decimal?                      @db.Decimal(10, 2)
  netQuantity                 Decimal?                      @db.Decimal(10, 2)
  netQuantityUnit             IngredientBaseUnit?
  servingSize                 Decimal?                      @db.Decimal(10, 2)
  servingUnit                 IngredientBaseUnit?
  householdMeasure            String?
  servingsPerPackage          Decimal?                      @db.Decimal(10, 4)
  isIndividualPackage         Boolean                       @default(false)
  confirmedAllergens          String[]                      @default([])
  glutenStatus                RecipeDisclosureStatus?
  lactoseStatus               RecipeDisclosureStatus?
  crossContaminationRisk      RecipeCrossContaminationRisk?
  crossContaminationAllergens String[]                      @default([])
  informationReviewedAt       DateTime?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  barcode     Barcode?

  @@index([userId])
  @@index([name])
  @@map("recipes")
}

model Barcode {
  id        String             @id @default(cuid())
  userId    String
  recipeId  String?            @unique
  type      BarcodeType
  value     String
  format    BarcodeValueFormat
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  usage  BarcodeUsage?

  @@unique([userId, value])
  @@index([userId])
  @@map("barcodes")
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  plan                   CommercialPlan
  status                 SubscriptionStatus
  startsAt               DateTime
  endsAt                 DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  provider               String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingCycles BillingCycle[]

  @@unique([provider, providerSubscriptionId])
  @@unique([id, userId])
  @@index([userId, status, startsAt])
  @@map("subscriptions")
}

model BillingCycle {
  id               String         @id @default(cuid())
  userId           String
  subscriptionId   String
  planSnapshot     CommercialPlan
  startsAt         DateTime
  endsAt           DateTime
  barcodeUsed      Int            @default(0)
  providerCycleId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription   @relation(fields: [subscriptionId, userId], references: [id, userId], onDelete: Restrict)
  barcodeUsages BarcodeUsage[]

  @@unique([subscriptionId, startsAt])
  @@unique([subscriptionId, providerCycleId])
  @@unique([id, userId])
  @@index([userId, startsAt, endsAt])
  @@map("billing_cycles")
}

model BarcodeUsage {
  id             String         @id @default(cuid())
  userId         String
  barcodeId      String?        @unique
  billingCycleId String?
  kind           BarcodeType
  planSnapshot   CommercialPlan
  createdAt      DateTime       @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  barcode      Barcode?      @relation(fields: [barcodeId], references: [id], onDelete: SetNull)
  billingCycle BillingCycle? @relation(fields: [billingCycleId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, billingCycleId, createdAt])
  @@index([userId, planSnapshot, createdAt])
  @@map("barcode_usages")
}

model RecipeIngredient {
  id           String             @id @default(cuid())
  recipeId     String
  ingredientId String
  amount       Decimal            @db.Decimal(10, 2)
  unit         IngredientBaseUnit
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}
