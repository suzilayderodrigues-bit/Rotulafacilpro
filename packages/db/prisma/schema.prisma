generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  customIngredients   Ingredient[]
  recipes             Recipe[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum IngredientSource {
  BASE_ROTULA
  CUSTOM
}

enum IngredientBaseUnit {
  GRAM
  MILLILITER
}

enum RecipePhysicalState {
  SOLID_OR_SEMISOLID
  LIQUID
}

enum RecipeDisclosureStatus {
  CONTAINS
  DOES_NOT_CONTAIN
  NEEDS_REVIEW
}

enum RecipeCrossContaminationRisk {
  YES
  NO
  UNKNOWN
}

model Ingredient {
  id              String             @id @default(cuid())
  name            String
  normalizedName  String
  source          IngredientSource
  category        String
  dataOrigin      String
  dataOriginUrl   String?
  sourceCode      String?
  sourceVersion   String?
  baseUnit        IngredientBaseUnit @default(GRAM)
  baseQuantity    Decimal            @default(100) @db.Decimal(10, 2)
  caloriesKcal    Decimal?           @db.Decimal(10, 2)
  carbohydratesG  Decimal?           @db.Decimal(10, 2)
  proteinsG       Decimal?           @db.Decimal(10, 2)
  totalFatG       Decimal?           @db.Decimal(10, 2)
  saturatedFatG   Decimal?           @db.Decimal(10, 2)
  transFatG       Decimal?           @db.Decimal(10, 2)
  fiberG          Decimal?           @db.Decimal(10, 2)
  sodiumMg        Decimal?           @db.Decimal(10, 2)
  sugarsG         Decimal?           @db.Decimal(10, 2)
  addedSugarsG    Decimal?           @db.Decimal(10, 2)
  calciumMg       Decimal?           @db.Decimal(10, 2)
  ironMg          Decimal?           @db.Decimal(10, 2)
  allergens       String[]           @default([])
  containsGluten  Boolean?
  containsLactose Boolean?
  notes           String?
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeItems     RecipeIngredient[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([source])
  @@index([category])
  @@index([userId])
  @@index([normalizedName])
  @@index([dataOrigin, sourceCode])
  @@map("ingredients")
}

model Recipe {
  id                          String                        @id @default(cuid())
  userId                      String
  name                        String
  foodCategory                String?
  physicalState               RecipePhysicalState
  finalYieldAmount            Decimal?                      @db.Decimal(10, 2)
  finalYieldUnit              IngredientBaseUnit
  unitsProduced               Int?
  unitWeight                  Decimal?                      @db.Decimal(10, 2)
  netQuantity                 Decimal?                      @db.Decimal(10, 2)
  netQuantityUnit             IngredientBaseUnit?
  servingSize                 Decimal?                      @db.Decimal(10, 2)
  servingUnit                 IngredientBaseUnit?
  householdMeasure            String?
  servingsPerPackage          Decimal?                      @db.Decimal(10, 4)
  isIndividualPackage         Boolean                       @default(false)
  confirmedAllergens          String[]                      @default([])
  glutenStatus                RecipeDisclosureStatus?
  lactoseStatus               RecipeDisclosureStatus?
  crossContaminationRisk      RecipeCrossContaminationRisk?
  crossContaminationAllergens String[]                      @default([])
  informationReviewedAt       DateTime?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([userId])
  @@index([name])
  @@map("recipes")
}

model RecipeIngredient {
  id           String             @id @default(cuid())
  recipeId     String
  ingredientId String
  amount       Decimal            @db.Decimal(10, 2)
  unit         IngredientBaseUnit
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}
